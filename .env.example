# .env.example
# Copy file này thành .env và điền giá trị thật của bạn vào
# KHÔNG commit file .env lên Git!

# ==============================================================================
# Cấu hình Flask App
# ==============================================================================
# Chế độ Debug (True cho dev, False cho production)
FLASK_DEBUG=True

# Cổng chạy ứng dụng
PORT=5000

# Secret Key (QUAN TRỌNG: Phải thay đổi chuỗi này trong môi trường production!)
# Bạn có thể sinh key bằng python: import secrets; print(secrets.token_hex(32))
FLASK_SECRET_KEY=change_this_to_a_very_long_random_string

# ==============================================================================
# Cấu hình Huấn luyện (Training Config)
# ==============================================================================
# Ẩn log khởi tạo cấu hình (True/False)
HIDE_CONFIG_LOGS=False

# Chạy benchmark chọn device (True/False)
RUN_DEVICE_BENCHMARK=False

# Tự động sync log lên Google Drive (True/False)
USE_DRIVE_FOR_LOGS=False
AUTO_SYNC_EVERY_EPOCH=False
